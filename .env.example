GEMINI_API_KEY=
# REST API (`rag serve`): comma-separated ADMIN keys (X-API-Key header; "Admin sign in" in the
# UI). Empty = admin endpoints return 503. Use long random values. Guests chat without a key.
API_KEYS=
# GUEST_QUESTIONS_PER_HOUR=20
# Sign in with Google (optional): the OAuth client id of this app (Google Cloud Console >
# Google Auth Platform > Clients > Web application; public, NOT the client secret). Admins =
# signed-in users with these emails. Empty client id = the UI uses the admin-key dialog instead.
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# ADMIN_EMAILS=you@gmail.com
# SESSION_DAYS=7
# USER_QUESTIONS_PER_HOUR=50
# Private collections per signed-in user (uploads beyond a limit are refused before embedding)
# USER_MAX_COLLECTIONS=5
# USER_MAX_DOCUMENTS=20
# USER_MAX_PASSAGES=500
# LangSmith tracing (optional, https://smith.langchain.com - the free Developer plan has a
# monthly trace allowance). The API traces; CLI batch runs only with `rag --trace-langsmith ...`.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=rag-platform
# LANGSMITH_SAMPLING_RATE=1.0   (share of requests traced)
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com   (EU region only)
# ONLINE_EVAL_SAMPLE_RATE=0.2  (share of chat answers scored for faithfulness/relevance; 0 = off)   (per IP; 0 = guests disabled, chat then needs an admin key)
# CHAT_RETENTION_DAYS=90   (chats without activity this long are deleted, daily; 0 = keep forever)
# USAGE_RETENTION_DAYS=90  (usage-log rows older than this are deleted; 0 = keep forever)
# CORS_ORIGINS=http://localhost:4200   (browser apps allowed to call the API, comma-separated)
# MAX_UPLOAD_MB=10
# UPLOAD_DIR=data/uploads
# Optional overrides
# CHAT_MODEL=gemini-3.5-flash-lite
# EMBEDDING_MODEL=gemini-embedding-001
# JUDGE_MODEL=   (LLM-as-judge for `rag eval`; defaults to CHAT_MODEL)
# CHAT_REQUESTS_PER_MINUTE=14   (free tier allows 15/min per model; raise on a paid tier)
# CHAT_BURST=2                  (calls sent back to back after an idle moment; 1 = none)
# CHAT_TIMEOUT_SECONDS=20       (per model request; then retried)
# CHAT_MAX_RETRIES=2            (worst case ~1 minute per model call when the provider is slow)
# EMBED_REQUESTS_PER_MINUTE=90  (free tier allows 100 texts/min; every text in a batch counts)
# RAG_ENV_FILE=.env.other       (read settings from another env file, e.g. a second API key)
# Second chat provider (optional): Groq writes answers when Gemini is out of quota or overloaded
# (or first - chosen in Admin › Settings). Free key at console.groq.com. Embeddings stay Gemini.
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_REQUESTS_PER_MINUTE=5    (Groq free tier: ~8,000 tokens/min, ~2,000 per answer prompt)
